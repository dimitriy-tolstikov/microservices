{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrdersDatabase": "Data Source=orders.db"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "orders",
    "MessageSendMaxRetries": 3,
    "RetryBackoffMs": 1000
  }
}
